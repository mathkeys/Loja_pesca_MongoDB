# Modelo de configuração de ambiente.
# Copie este arquivo para um novo arquivo chamado ".env" e preencha com a
# string de conexão real do MongoDB Atlas. O arquivo .env NÃO vai para o
# repositório (está listado no .gitignore).

# String de conexão do MongoDB Atlas.
# Obtenha em: Atlas -> Database -> Connect -> Drivers -> Python
# Troque <usuario>, <senha> e <cluster> pelos seus valores reais.
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nome do banco e da coleção (opcionais — já têm valores padrão no código)
DB_NAME=loja_pesca
COLLECTION_NAME=produtos
